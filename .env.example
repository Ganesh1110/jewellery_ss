# Shopify Storefront API Configuration
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
NEXT_PUBLIC_SHOPIFY_STOREFRONT_TOKEN=your-storefront-access-token
NEXT_PUBLIC_SHOPIFY_STOREFRONT_API_VERSION=2024-04

# Cart & Checkout
NEXT_PUBLIC_CART_DRAWER_ENABLED=true

# Analytics (optional)
NEXT_PUBLIC_GA_ID=

# MySQL Database
DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/sss_ecommerce"

# Admin (defaults used by the seed script)
ADMIN_EMAIL="admin@sss.com"
ADMIN_PASSWORD="admin123"