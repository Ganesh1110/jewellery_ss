# Storefront settings
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
NEXT_PUBLIC_SHOPIFY_STOREFRONT_TOKEN=your-storefront-access-token
NEXT_PUBLIC_SHOPIFY_STOREFRONT_API_VERSION=2024-04

# Cart & Checkout
NEXT_PUBLIC_CART_DRAWER_ENABLED=true

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Analytics (optional)
NEXT_PUBLIC_GA_ID=

# PostgreSQL Database (Required)
# Use pooled connection string for DATABASE_URL (PgBouncer / Supabase Pooler / RDS Proxy)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/sss_ecommerce?schema=public&sslmode=prefer"
# DIRECT_URL="postgresql://USER:PASSWORD@localhost:5432/sss_ecommerce?schema=public"

# Site URL
NEXT_PUBLIC_SITE_URL=https://shakthiatelier.com

# Cart & Features
NEXT_PUBLIC_CART_DRAWER_ENABLED=true

# Admin Credentials (Used by seed script)
ADMIN_EMAIL="admin@sss.com"
ADMIN_PASSWORD="admin123"

# Analytics & Monitoring (Optional)
NEXT_PUBLIC_GA_ID=
SENTRY_DSN=

# Storage (AWS S3 / Cloudflare R2 - Optional, falls back to /public/uploads if empty)
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_BUCKET=sss-media
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# NEXT_PUBLIC_CDN_URL=https://media.shakthiatelier.com

# Rate Limiting & Distributed Cache (Optional Upstash Redis, falls back to in-memory)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Payment Gateway Webhook Secret (Razorpay / Stripe)
# PAYMENT_WEBHOOK_SECRET=

